#!/bin/sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PLUGIN_ROOT_RESOLVED=${PLUGIN_ROOT:-$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)}

for candidate in \
    "$PLUGIN_ROOT_RESOLVED/target/release/ov-agy" \
    "$PLUGIN_ROOT_RESOLVED/target/release/ov-agy.exe" \
    "$PLUGIN_ROOT_RESOLVED/target/debug/ov-agy" \
    "$PLUGIN_ROOT_RESOLVED/target/debug/ov-agy.exe"
do
    if [ -x "$candidate" ]; then
        exec "$candidate" "$@"
    fi
done

MANIFEST_FILE="$PLUGIN_ROOT_RESOLVED/.antigravity-plugin/plugin.json"
if [ ! -f "$MANIFEST_FILE" ]; then
    echo "[ov-agy] Missing plugin manifest at $MANIFEST_FILE" >&2
    exit 1
fi

if command -v jq >/dev/null 2>&1; then
    VERSION=$(jq -r '.version // empty' "$MANIFEST_FILE" 2>/dev/null || true)
else
    VERSION=""
fi

if [ -z "$VERSION" ]; then
    VERSION=$(tr -d '\r' < "$MANIFEST_FILE" | awk -F'"' '
        {
            for (i = 1; i <= NF; i++) {
                if ($i == "version" && (i + 2) <= NF && $(i + 1) ~ /^[[:space:]]*:[[:space:]]*$/) {
                    print $(i + 2)
                    exit
                }
            }
        }
    ')
fi

VERSION=${VERSION#v}
if [ -z "$VERSION" ]; then
    echo "[ov-agy] Failed to read non-empty version from $MANIFEST_FILE" >&2
    exit 1
fi

DATA_DIR=${OPENVIKING_PLUGIN_DATA:-${PLUGIN_DATA:-"$HOME/.openviking/agy-plugin"}}
case "$(uname -s 2>/dev/null || echo unknown)" in
    MINGW*|MSYS*|CYGWIN*) BIN_EXT=".exe" ;;
    *)                    BIN_EXT="" ;;
esac
CACHED_BIN="$DATA_DIR/bin/ov-agy-v${VERSION}${BIN_EXT}"

if [ ! -x "$CACHED_BIN" ]; then
    "$PLUGIN_ROOT_RESOLVED/scripts/fetch-binary.sh" "$VERSION" "$CACHED_BIN" >&2
fi

exec "$CACHED_BIN" "$@"
