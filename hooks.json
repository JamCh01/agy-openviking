{
  "openviking": {
    "enabled": true,
    "SessionStart": [
      {
        "type": "command",
        "command": "sh ./scripts/ov-agy hook session-start",
        "timeout": 5
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "sh ./scripts/ov-agy hook pre-invocation",
        "timeout": 30
      }
    ],
    "PostInvocation": [
      {
        "type": "command",
        "command": "sh ./scripts/ov-agy hook post-invocation",
        "timeout": 5
      }
    ],
    "PreToolUse": [
      {
        "matcher": "view_file|read_file|write_to_file|write_file|replace_file_content|multi_replace_file_content|edit_file|sed_file|notebook_edit|list_dir|grep_search|find_by_name",
        "hooks": [
          {
            "type": "command",
            "command": "sh ./scripts/ov-agy hook pre-tool",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "sh ./scripts/ov-agy hook stop",
        "timeout": 5
      }
    ]
  }
}
